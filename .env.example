# ==============================================================================
# UEHIS — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env (root) and frontend/.env before running the application.
# Safe placeholder values only — DO NOT commit real secrets or credentials.

# ------------------------------------------------------------------------------
# 1. Environment Mode
# ------------------------------------------------------------------------------
# Set to 'production' in deployed environments (enforces fail-closed security).
# Set to 'development' for local coding and testing.
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL + PostGIS)
# ------------------------------------------------------------------------------
# Production (AWS + Supabase Cloud): Enforce TLS with ?sslmode=require
# postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
POSTGRES_USER=uehis
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=uehis
DATABASE_URL=postgresql://your-username:your-password@localhost:5432/your-db-name?sslmode=prefer
# Optional: Dedicated connection string for Docker container network
DOCKER_DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. Supabase Authentication & Storage Tier
# ------------------------------------------------------------------------------
# [BUILD-TIME & RUNTIME]: Public Supabase project URL (must be HTTPS in production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# [BUILD-TIME & RUNTIME]: Public anonymous API key (safe for browser distribution)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# [RUNTIME SERVER-ONLY]: Supabase Service Role key (NEVER expose to client/browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# [RUNTIME SERVER-ONLY]: Internal network URL for container-to-Supabase calls
# Local dev: http://host.docker.internal:54221 or http://127.0.0.1:54221
# Production: Same as NEXT_PUBLIC_SUPABASE_URL (e.g. https://your-project-ref.supabase.co)
SUPABASE_INTERNAL_URL=https://your-project-ref.supabase.co

# [BUILD-TIME & RUNTIME]: Canonical public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Microservice Inter-Service Security
# ------------------------------------------------------------------------------
# [RUNTIME SERVER-ONLY]: Shared secret token between Next.js server and FastAPI
# Required when ENVIRONMENT=production (FastAPI fails closed without this key)
UEHIS_API_KEY=your-uehis-internal-api-key-here

# [RUNTIME SERVER-ONLY]: URL of the FastAPI microservice as accessed by Next.js
# Docker Compose: http://api:8000 | Local non-docker: http://127.0.0.1:8000
PYTHON_SERVICE_URL=http://api:8000

# ------------------------------------------------------------------------------
# 5. External Geospatial & Data APIs
# ------------------------------------------------------------------------------
# [BUILD-TIME]: MapTiler public key for client-side satellite and vector basemaps
NEXT_PUBLIC_MAPTILER_API_KEY=your-maptiler-public-api-key-here

# [RUNTIME SERVER-ONLY]: MapTiler key for server-side raster/tile requests
MAPTILER_API_KEY=your-maptiler-server-api-key-here

# [RUNTIME SERVER-ONLY]: Geoapify API key for server-side location autocomplete
GEOAPIFY_API_KEY=your-geoapify-api-key-here

# [RUNTIME SERVER-ONLY]: OpenWeather API key for temperature/humidity ingestion
OPENWEATHER_API_KEY=your-openweather-api-key-here

# [RUNTIME SERVER-ONLY]: Google Earth Engine cloud project ID
GEE_PROJECT_ID=your-gee-project-id-here

# ------------------------------------------------------------------------------
# 6. Rate Limiting Defaults (Optional Overrides)
# ------------------------------------------------------------------------------
AUTH_IP_FLOOD_LIMIT=30
AUTH_IP_FLOOD_WINDOW_MS=60000
AUTH_LOGIN_MAX_FAILED_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MS=60000
