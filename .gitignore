# ============================================================
# UEHIS .gitignore
# ============================================================

# --- Python bytecode & caches ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# --- Virtual environments ---
venv/
.venv/
env/

# --- Credentials & local config ---
.env
.env.*
*.pem
*.crt

# --- Large raster datasets ---
*.tif
*.tiff
# Allow small tracked sample TIFs if explicitly git-added

# --- Large raw / generated data ---
*.pbf
*.npy
UEHIS_exports/
cache/

# --- Large zips & model weight archives ---
uehis_verified_weights.zip
feature_engineering.zip
patches_4class.zip
patches_4class_dense.zip
patches_4class_spatial.zip
# patches_4class_spatial_with_slope.zip tracked via LFS
# *.pth tracked via LFS

# --- Generated outputs ---
outputs/

# --- OS & editor temporary files ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# --- PDF / binary documents (not source code) ---
*.pdf

# --- Large images (generated maps/previews) ---
pune_study_area_map.png
pune_study_area_map_labeled.png
kothrud_labels_preview.png
kothrud_pune_composite.tif
kothrud_dynamicworld_labels_2026.tif

# --- Temporary logs ---
*.log

# --- Archive old training datasets (large zips) ---
archive/old_experiments/UEHIS_training/*.zip

# --- Presentation files ---
# UEHIS_CA2_Merged_Deck.pptx is tracked for documentation

# --- Jupyter checkpoints ---
.ipynb_checkpoints/

# --- Local scratch, audit scripts, and test artifacts ---
scratch/
brain/
audit_*.py
audit_*.json
bootstrap_users.py
*.bak
*.bak.*
*.backup_*
*.before_*
*.patch
stitch_uehis_environmental_intelligence_atlas/

# --- Dependencies & Playwright QA ---
node_modules/
tests/playwright_qa/

# --- Jupyter notebooks ---
*.ipynb

# --- Temporary SQL files & scratch output ---
*validation*.sql
*validation*.txt
geom.json
payload.json
temp.txt

# --- Semantic validation images & local previews ---
UEHIS_Production_2026/semantic_validation_samples/
Logo.png

# --- Large production datasets & exports (preserved on disk) ---
UEHIS_Production_2026/*.geojson
UEHIS_Production_2026/*.csv
UEHIS_Production_2026/*.csv.bak

# --- Duplicate model weights & experimental training directories ---
UEHIS Code/
UEHIS_training/unet_weights_slope_run*.pth
UEHIS_training/patches_*/

